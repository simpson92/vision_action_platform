# 복사해서 사용: cp .env.example .env   (.env는 Git에 올리지 않음)
# 서비스 주소(POSTGRES_HOST, CELERY_BROKER_URL, FASTAPI_URL)는 compose.yaml이 서비스 이름으로 넣어 줍니다.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 처음 실행할 때 관리자 계정을 자동으로 만들려면 채우기 (비워 두면 createsuperuser로 직접 생성)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---- PostgreSQL ----
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---- Celery → FastAPI ----
FASTAPI_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=50

# ---- IP Webcam ----
# 허용한 카메라 주소만 쉼표로 나열. 화면에는 "카메라 1"처럼 번호만 보이고 주소는 노출되지 않음
IP_WEBCAM_ALLOWED_URLS=http://<휴대폰-IP>:8080/video
IP_WEBCAM_CAPTURE_SECONDS=8
IP_WEBCAM_CONNECT_TIMEOUT=5

# ---- AI 추론 (ai_service) ----
POSE_MODEL=yolo11n-pose.pt
# 판단 보류 기준과 Window (기본값은 S02 검증 영상으로 정함, docs/evaluation_S02_S03.txt)
CONFIDENCE_THRESHOLD=0.20
MARGIN_THRESHOLD=0.03
WINDOW_SECONDS=2.0
WINDOW_STRIDE_SECONDS=0.5
KEYPOINT_INTERPOLATION=1
KEYPOINT_MIN_CONFIDENCE=0.30
