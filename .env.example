# 복사해서 사용: cp .env.example .env   (.env는 Git에 올리지 않음)

# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL ----
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis / Celery ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- FastAPI (AI 추론 서버) ----
FASTAPI_URL=http://fastapi:8000
FASTAPI_TIMEOUT_SECONDS=120
MODEL_DIR=/app/models
POSE_MODEL=yolo11n-pose.pt
CONFIDENCE_THRESHOLD=0.5

# ---- IP Webcam ----
# 허용한 카메라 주소만 쉼표로 나열 (실제 주소는 .env에만 적기)
IP_WEBCAM_ALLOWED_URLS=http://<휴대폰-IP>:8080/video
IP_WEBCAM_CAPTURE_SECONDS=8
